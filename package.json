{
  "name": "mercurius-apollo-registry",
  "version": "2.1.4",
  "description": "A schema reporting plugin for Mercurius",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:staged": "lint-staged"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:nearform/mercurius-apollo-registry.git"
  },
  "keywords": [
    "mercurius",
    "graphql",
    "apollo",
    "schema",
    "reporter"
  ],
  "bugs": {
    "url": "https://github.com/nearform/mercurius-apollo-registry/issues"
  },
  "homepage": "https://github.com/nearform/mercurius-apollo-registry#readme",
  "engines": {
    "node": ">=20"
  },
  "author": "Nigel Hanlon <nigel.hanlon@nearform.com>",
  "license": "Apache-2.0",
  "dependencies": {
    "fastify-plugin": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-standard": "^5.0.0",
    "faker": "^5.5.3",
    "fastify": "^4.29.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nock": "^14.0.10",
    "prettier": "^3.7.4",
    "sinon": "^18.0.1"
  },
  "peerDependencies": {
    "mercurius": "^13.0.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint:staged",
      "pre-push": "npm run lint && npm run test"
    }
  }
}
